{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SplashArray",
  "$defs": {
    "SplashArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 40
          },
          {
            "type": "object",
            "required": [ "group", "splashes" ],
            "properties": {
              "group": {
                "type": "string",
                "description": "The \"group\" key is currently purely for documentation; it does not affect the build data."
              },
              "splashes": {
                "$ref": "#/$defs/SplashArray"
              }
            }
          }
        ]
      }
    }
  }
}
