{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SplashArray",
  "$defs": {
    "SplashArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 40
          },
          {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "splashes": {
                "$ref": "#/$defs/SplashArray"
              }
            }
          }
        ]
      }
    }
  }
}